{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:rikai:understanding-payload:v1",
  "title": "RIKAI Understanding AI payload v1",
  "description": "Untrusted AI payload only; hashes, verification and review metadata are assigned by the backend.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "businessRules",
    "designs",
    "questions"
  ],
  "properties": {
    "schemaVersion": {
      "const": "understanding-v1"
    },
    "businessRules": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/definitions/businessRule"
      }
    },
    "designs": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/definitions/design"
      }
    },
    "questions": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/definitions/question"
      }
    }
  },
  "definitions": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "startLine",
        "endLine",
        "quote"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)\\.{1,2}(?:/|$)).+$"
        },
        "startLine": {
          "type": "integer",
          "minimum": 1
        },
        "endLine": {
          "type": "integer",
          "minimum": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        }
      }
    },
    "businessRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "statement",
        "basis",
        "inputs",
        "outputs",
        "conditions",
        "evidence",
        "openQuestionIds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^BR-[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "basis": {
          "enum": [
            "observed",
            "hypothesis"
          ]
        },
        "inputs": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "outputs": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "conditions": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "evidence": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/definitions/evidence"
          }
        },
        "openQuestionIds": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "string",
            "pattern": "^Q-[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "basis": {
                "const": "observed"
              }
            },
            "required": [
              "basis"
            ]
          },
          "then": {
            "properties": {
              "evidence": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "kind",
        "summary",
        "relatedBusinessRuleIds",
        "constraints",
        "evidence",
        "openQuestionIds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^DS-[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "kind": {
          "enum": [
            "current_behavior",
            "target_suggestion"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "relatedBusinessRuleIds": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "string",
            "pattern": "^BR-[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          },
          "uniqueItems": true
        },
        "constraints": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "evidence": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/definitions/evidence"
          }
        },
        "openQuestionIds": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "string",
            "pattern": "^Q-[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "current_behavior"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "evidence": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "question",
        "relatedIds",
        "blocking"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^Q-[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "relatedIds": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "string",
            "pattern": "^(BR|DS)-[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          },
          "uniqueItems": true
        },
        "blocking": {
          "type": "boolean"
        }
      }
    }
  }
}
